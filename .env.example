# Copiez ce fichier en « .env » (jamais commité) puis adaptez les valeurs.
# --- Développement : rien à définir, les valeurs par défaut suffisent ---

# --- Production ---
DJANGO_DEBUG=0
# Générez une clé : python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=remplacez-par-une-longue-cle-aleatoire-de-50-caracteres-ou-plus
DJANGO_ALLOWED_HOSTS=exemple.com,www.exemple.com
# Mettre 0 seulement si un proxy HTTPS gère déjà la redirection
SECURE_SSL_REDIRECT=1

# Tâches asynchrones (prévisions) : CELERY_EAGER=0 + Redis + « celery -A config worker -l info »
CELERY_EAGER=0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
